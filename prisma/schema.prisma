generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Authentication & Users ─────────────────────────────────────────

enum UserRole {
  CUSTOMER
  ADMIN
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  hashedPassword String?
  phone          String?
  role           UserRole  @default(CUSTOMER)
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  profile  CustomerProfile?
  orders   Order[]
  reviews  Review[]
  cart     Cart?

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

// ─── Customer Profile & Addresses ───────────────────────────────────

model CustomerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String?
  taxId       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses Address[]
}

model Address {
  id              String  @id @default(cuid())
  profileId       String
  label           String? // e.g. "Home", "Office"
  firstName       String
  lastName        String
  company         String?
  address1        String
  address2        String?
  city            String
  state           String
  postalCode      String?
  country         String  @default("Nigeria")
  phone           String?
  isDefault       Boolean @default(false)

  profile        CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  shippingOrders Order[]         @relation("ShippingAddress")

  @@index([profileId])
}

// ─── Product Catalog ────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  image       String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([slug])
  @@index([parentId])
}

model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  logo        String?
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([slug])
}

model Product {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  sku             String   @unique
  description     String?  @db.Text
  shortDescription String? @db.VarChar(500)
  categoryId      String
  brandId         String?
  priceInKobo     Int      // Store price in kobo (smallest unit)
  comparePriceInKobo Int?  // Original price for showing discounts
  costPriceInKobo Int?     // Cost price for margin calculations
  stock           Int      @default(0)
  lowStockThreshold Int    @default(5)
  weight          Float?   // in kg
  isFeatured      Boolean  @default(false)
  isBestSeller    Boolean  @default(false)
  isActive        Boolean  @default(true)
  metaTitle       String?
  metaDescription String?  @db.VarChar(320)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category       Category              @relation(fields: [categoryId], references: [id])
  brand          Brand?                @relation(fields: [brandId], references: [id])
  images         ProductImage[]
  variants       ProductVariant[]
  specifications ProductSpecification[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  reviews        Review[]

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([brandId])
  @@index([isFeatured])
  @@index([isBestSeller])
  @@index([isActive])
  @@index([priceInKobo])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id          String  @id @default(cuid())
  productId   String
  name        String  // e.g. "1/2 inch", "3/4 inch"
  sku         String  @unique
  priceInKobo Int
  stock       Int     @default(0)
  attributes  Json?   // { diameter: "1/2", material: "PVC", length: "6m" }
  isActive    Boolean @default(true)

  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([sku])
}

model ProductSpecification {
  id        String @id @default(cuid())
  productId String
  name      String // e.g. "Diameter", "Material", "Pressure Rating"
  value     String // e.g. "1/2 inch", "PVC", "16 bar"
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ─── Shopping Cart ──────────────────────────────────────────────────

model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique
  sessionId String?  @unique // for guest carts
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([sessionId])
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int    @default(1)

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

// ─── Orders ─────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  PROCESSING
  READY_FOR_DISPATCH
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  userId            String?
  guestEmail        String?
  guestPhone        String?
  status            OrderStatus @default(PENDING)
  subtotalInKobo    Int
  deliveryFeeInKobo Int         @default(0)
  discountInKobo    Int         @default(0)
  taxInKobo         Int         @default(0)
  totalInKobo       Int
  currency          String      @default("NGN")
  note              String?     @db.Text
  shippingAddressId String?
  shippingAddress   Json?       // Snapshot of address at order time
  couponId          String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user     User?       @relation(fields: [userId], references: [id])
  address  Address?    @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  coupon   Coupon?     @relation(fields: [couponId], references: [id])
  items    OrderItem[]
  payments Payment[]
  delivery Delivery?

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  productId   String
  variantId   String?
  name        String
  sku         String
  quantity    Int
  priceInKobo Int
  totalInKobo Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

// ─── Payments ───────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  MANUAL
}

model Payment {
  id              String          @id @default(cuid())
  orderId         String
  reference       String          @unique
  provider        PaymentProvider @default(PAYSTACK)
  status          PaymentStatus   @default(PENDING)
  amountInKobo    Int
  currency        String          @default("NGN")
  providerRef     String?         // Paystack/Flutterwave transaction reference
  metadata        Json?
  paidAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  order        Order                @relation(fields: [orderId], references: [id])
  transactions PaymentTransaction[]

  @@index([orderId])
  @@index([reference])
  @@index([providerRef])
}

model PaymentTransaction {
  id         String   @id @default(cuid())
  paymentId  String
  event      String   // e.g. "charge.success", "refund.processed"
  data       Json
  processedAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([event])
}

// ─── Delivery ───────────────────────────────────────────────────────

enum DeliveryStatus {
  PENDING
  PROCESSING
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  FAILED
}

model Delivery {
  id              String         @id @default(cuid())
  orderId         String         @unique
  status          DeliveryStatus @default(PENDING)
  trackingNumber  String?
  carrier         String?
  estimatedDate   DateTime?
  deliveredDate   DateTime?
  instructions    String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([trackingNumber])
}

// ─── Coupons ────────────────────────────────────────────────────────

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Coupon {
  id              String       @id @default(cuid())
  code            String       @unique
  description     String?
  discountType    DiscountType
  discountValue   Int          // percentage or kobo amount
  minOrderInKobo  Int?         // minimum order amount
  maxDiscountKobo Int?         // cap for percentage discounts
  maxUses         Int?
  usedCount       Int          @default(0)
  isActive        Boolean      @default(true)
  validFrom       DateTime     @default(now())
  validUntil      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  orders Order[]

  @@index([code])
}

// ─── Reviews ────────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int      // 1-5
  title     String?
  comment   String?  @db.Text
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
}

// ─── Newsletter ─────────────────────────────────────────────────────

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  isSubscribed Boolean  @default(true)
  subscribedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Store Settings ─────────────────────────────────────────────────

model StoreSettings {
  id                String  @id @default(cuid())
  storeName         String  @default("PlumbMart")
  storeEmail        String?
  storePhone        String?
  storeAddress      String? @db.Text
  currency          String  @default("NGN")
  taxRate           Float   @default(0)
  freeDeliveryMin   Int?    // minimum kobo for free delivery
  flatDeliveryFee   Int     @default(0) // kobo
  enableGuestCheckout Boolean @default(true)
  enableReviews     Boolean @default(true)
  maintenanceMode   Boolean @default(false)
  logoUrl           String?
  faviconUrl        String?
  metaTitle         String?
  metaDescription   String? @db.VarChar(320)
  socialLinks       Json?   // { facebook, twitter, instagram, etc. }
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
